ENV=development
SECRET_KEY=generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

CORS_ORIGINS=[]

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=1500

DB_BACKEND=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/debate_win
UPLOAD_DIR=/data/uploads

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

CREDITS_FORENSIC_ANALYSIS=3
CREDITS_FUMBLE_ANALYSIS=1
CREDITS_SPARRING_TURN=1
CREDITS_NEW_USER_BONUS=20

RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_AI_PER_MINUTE=10

STORAGE_BUCKET=receipts
MAX_UPLOAD_MB=10

ZERO_LOG_RETENTION=true
